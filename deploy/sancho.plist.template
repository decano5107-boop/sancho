<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Filled in by deploy/install.sh. Starts Sancho at login and restarts it if it exits. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>__LABEL__</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>__PATH__</string>
	</dict>
	<key>ProgramArguments</key>
	<array>
		<string>__PYTHON__</string>
		<string>-m</string>
		<string>sancho.listener</string>
	</array>
	<key>WorkingDirectory</key>
	<string>__REPO__</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<!-- 30 s between restarts: if the failure is the network or the token,
	     retrying every second only fills the log. -->
	<key>ThrottleInterval</key>
	<integer>30</integer>
	<key>StandardErrorPath</key>
	<string>__LOGS__/sancho.err.log</string>
	<key>StandardOutPath</key>
	<string>__LOGS__/sancho.out.log</string>
</dict>
</plist>
