# Copy to .env (never committed) and fill in. The assistant itself cannot read this file:
# the gate denies .env, .env.* and .envrc anywhere, and every file in Sancho's own folder.

# From @BotFather. Create a bot used only for this.
TELEGRAM_BOT_TOKEN=

# Your own chat id with the bot. Messages from any other chat are dropped.
TELEGRAM_CHAT_ID=

# From `claude setup-token`. Lets the headless `claude -p` use your subscription.
CLAUDE_CODE_OAUTH_TOKEN=
